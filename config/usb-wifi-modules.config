# Lime USB Wi-Fi / loadable-module config fragment
# Merged on top of arch/arm64/configs/vendor/bengal_defconfig.

# Loadable modules. Debian-style loading needs these and no forced signatures.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODVERSIONS=y
CONFIG_MODULE_SRCVERSION_ALL=y
# CONFIG_MODULE_SIG is not set
# CONFIG_MODULE_SIG_FORCE is not set
# CONFIG_MODULE_SIG_ALL is not set
# CONFIG_MODULE_SIG_SHA512 is not set

# Wireless stack needed by mac80211-based USB Wi-Fi drivers.
CONFIG_WIRELESS=y
CONFIG_WLAN=y
CONFIG_CFG80211=y
CONFIG_CFG80211_INTERNAL_REGDB=y
CONFIG_MAC80211=y
CONFIG_WLAN_VENDOR_MEDIATEK=y
CONFIG_WLAN_VENDOR_REALTEK=y

# USB host side. Stock bengal_defconfig already has most of these; keep them explicit.
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_MSM=y

# Firmware loading from /vendor/firmware.
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_USER_HELPER=y
CONFIG_FW_LOADER_USER_HELPER_FALLBACK=y

# In-tree USB Wi-Fi drivers built as modules.
CONFIG_RTL8XXXU=m
CONFIG_RTL8XXXU_UNTESTED=y
CONFIG_RTL8192CU=m
CONFIG_MT7601U=m
CONFIG_MT76_CORE=m
CONFIG_MT76_USB=m
CONFIG_MT76x0U=m
CONFIG_MT76x2_COMMON=m
CONFIG_MT76x2U=m

# Keep the familiar gzip kernel image; DTB/DTBO stays untouched from the ROM.
CONFIG_BUILD_ARM64_KERNEL_COMPRESSION_GZIP=y
